    - target: {fileID: 5791512194920739496, guid: be4fbca1c32b1476780795f41bfd933f, type: 3}
      propertyPath: questJournal
      value: 
      objectReference: {fileID: 6976901023203077581}
    - target: {fileID: 6092445672109860940, guid: be4fbca1c32b1476780795f41bfd933f, type: 3}
      propertyPath: m_Text
      value: "\u0412\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u044F
        \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E
        \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430
        \u2013 \u0413\u043E\u043B\u0443\u0431\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430
        \u0432 \u043B\u0435\u0432\u043E\u043C \u043D\u0438\u0436\u043D\u0435\u043C
        \u0443\u0433\u043B\u0443\r\n\r\n\u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u0438\u0433\u0440\u043E\u043A\u0430 \u2013 WASD\r\n\u041F\u0440\u044B\u0436\u043E\u043A
        \u2013 Space\r\n\u0420\u0435\u0436\u0438\u043C \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u0438
        \u2013 Ctrl \u0438\u043B\u0438 C\r\n\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
        \u2013 \u0414\u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430
        1-4, \u041B\u041A\u041C \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
        \u0437\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
        \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C\r\n\u0411\u0440\u043E\u0441\u043E\u043A
        \u043A\u0430\u043C\u043D\u044F \u2013 G\r\n\u041D\u0415 \u041D\u0410\u0416\u0418\u041C\u0410\u0419
        \u2013 K\r\n\r\n\u041A\u0430\u043C\u043D\u0438 \u2013 \u0411\u0443\u0440\r\n\u0424\u0430\u0443\u043D\u0430,
        \u0434\u0435\u0440\u0435\u0432\u044C\u044F, \u043A\u0443\u0441\u0442\u044B
        \u2013 \u0421\u043A\u0430\u043D\u0435\u0440\r\n\u0413\u0440\u0438\u0431\u044B
        \u0438 \u0446\u0432\u0435\u0442\u044B \u2013 \u0421\u043F\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0442\u0440\r\n\u041C\u0438\u043D\u0435\u0440\u0430\u043B\u044B
        \u2013 \u0413\u0440\u0430\u0432\u0438\u043C\u0435\u0442\u0440\r\n\r\n\u0411\u0443\u0440
        \u2013 \u0423\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u043E\u0447\u043A\u0443
        \u0432 \u0437\u0435\u043B\u0435\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
        (\u041B\u041A\u041C - \u0432\u043B\u0435\u0432\u043E, \u041F\u041A\u041C
        - \u0432\u043F\u0440\u0430\u0432\u043E)\r\n\u0421\u043A\u0430\u043D\u0435\u0440
        \u2013 \u0417\u0430\u0436\u0430\u0442\u044C \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
        \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0435\r\n\u0421\u043F\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0442\u0440
        \u2013 \u0421\u0434\u0435\u043B\u0430\u0442\u044C \u0431\u043B\u0438\u0437\u043A\u0438\u0435
        \u0434\u0440\u0443\u0433 \u043A \u0434\u0440\u0443\u0433\u0443 \u0446\u0432\u0435\u0442\u0430\r\n\u0413\u0440\u0430\u0432\u0438\u043C\u0435\u0442\u0440
